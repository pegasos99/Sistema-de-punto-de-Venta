# Copia este archivo como server/.env (NO subir a Git ni compartir en el chat).
# Desde la raíz del repositorio, PowerShell:
# Copy-Item server\.env.example server\.env

PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173

# URL pública del proyecto de DESARROLLO ya creado.
SUPABASE_URL=https://ejmahzmyzmdfjadiqkdp.supabase.co
# Supabase Dashboard > Project Settings > API Keys > Publishable key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Supabase Dashboard > Connect > Session pooler > Connection string (URI).
# Reemplaza el marcador de contraseña y conserva host, puerto y usuario reales.
# Usa la contraseña de BASE DE DATOS, no la contraseña de tu cuenta Supabase.
# NUNCA usar esta variable en src/ ni en variables VITE_*.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres?sslmode=require
