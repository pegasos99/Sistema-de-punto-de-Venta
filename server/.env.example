# Copiar a server/.env; NO compartir valores reales ni subir .env a Git.
PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Usar la connection string de PostgreSQL (preferir pooler si IPv4).
# Nunca configurar DATABASE_URL en Vite ni en el frontend.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
